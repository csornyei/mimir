# LLM
LLM_BASE_URL=http://localhost:8080
API_KEY=
LLM_MODEL=google/gemma-4-E2B-it
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Embeddings
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# Memory
SEMANTIC_MEMORY_PATH=vault/memory.md

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mimir

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Approval flow
# ID of the DM channel between the bot and the owner (find via Slack API or bot logs)
SLACK_DM_CHANNEL_ID=
# Minutes before a PENDING approval times out and is auto-rejected (0 = no timeout)
APPROVAL_TIMEOUT_MINUTES=10
# Hours before a DISCUSSING approval times out (0 = never)
APPROVAL_DISCUSS_TIMEOUT_HOURS=24
# Whether to re-invoke the LLM with the tool result after approval execution
APPROVAL_REINVOKE_LLM=true

# Environment
ENV=development

CALDAV_URL=https://cal.example.com
CALDAV_USERNAME=user
CALDAV_PASSWORD=pass
